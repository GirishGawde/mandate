# mock (default, no account needed) or sandbox
PAYPAL_MODE=mock
# From developer.paypal.com > Apps & Credentials > your Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional overrides
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_RETURN_URL=http://localhost:3000/paypal/return
# PAYPAL_CANCEL_URL=http://localhost:3000/paypal/cancel

# LLM Configuration (live or scripted)
NEGOTIATION_MODE=live
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
# Optional fallback model tried on 503/429/timeout
LLM_FALLBACK_MODEL=claude-3-5-sonnet-20241022
LLM_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=
# or for Google:
# LLM_PROVIDER=google
# LLM_MODEL=gemini-1.5-flash
# LLM_FALLBACK_MODEL=gemini-1.5-pro
# GOOGLE_GENERATIVE_AI_API_KEY=

# Quiet Vercel AI SDK deprecation notices
AI_SDK_LOG_WARNINGS=false
